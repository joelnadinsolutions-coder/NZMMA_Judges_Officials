# NZMMAF Roundmaster — environment variables
#
# Copy this file to .env.local and fill in the two values from your Supabase
# project (Project Settings -> API). .env.local is git-ignored and stays on
# your machine only. Never commit real keys.
#
# The anon key is a public client key (safe to ship in a browser build); it is
# NOT the service_role key. Do not put the service_role key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
